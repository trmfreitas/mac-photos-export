DIR_TMP_ORIG="/Volumes/S3 1TB/exported/tmp_orig"
DIR_TMP_PROCESSED="/Volumes/S3 1TB/exported/tmp_processed"
DIR_EXPORT="/Volumes/S3 1TB/exported"

# album to load photos from
ALBUM_NAME="Smart/SYS-NotExported"


# keyword applied when good export
KEYWORD_EXPORTED=exportedT

# keyword applied when export failed
KEYWORD_FAILED=exportFailed

# keyword to skip export entirely
KEYWORD_SKIP=skipExport

# when true, photos without an a: keyword are exported to year/month folders instead of being skipped
EXPORT_USING_DATE_AS_FOLDER_IF_KEYWORD_NOT_AVAILABLE=false


EXIFTOOL=/opt/homebrew/bin/exiftool

# wall-clock timeout in seconds passed to run.sh (0 = no limit, default 21600 = 6 hours)
TIMEOUT_SECS=21600

# extensions to export only originals(comma-separated, no spaces)
ORIGINALS_ONLY_EXTS=".ARW,.RAF,.NEF"